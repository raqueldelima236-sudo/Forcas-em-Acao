[node name="Texto" type="RichTextLabel" parent="CanvasLayer/Interface"]
layout_mode = 0
offset_left = 34
offset_top = 92
offset_right = 734
offset_bottom = 386
mouse_filter = 2
bbcode_enabled = true
text = "A [b]força gravitacional[/b] é a atração que a Terra exerce sobre os objetos. Perto da superfície, essa força é o [b]peso[/b]: [b]P = m · g[/b], com g ≈ 9,8 m/s². A [b]massa[/b] mede a quantidade de matéria e não muda; o peso depende da gravidade.\n\nA [b]força normal (N)[/b] é a força que a superfície faz sobre o objeto, perpendicular a ela. Em um bloco parado no piso horizontal, [b]N = P[/b], com sentido oposto. Em uma rampa, N e P podem ser diferentes. (HEWITT, 2015)"
scroll_active = false
theme_override_colors/default_color = Color(0.90980, 0.92549, 1.00000, 1.000)
theme_override_font_sizes/normal_font_size = 21
theme_override_font_sizes/bold_font_size = 21

